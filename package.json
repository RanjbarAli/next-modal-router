{
  "name": "next-modal-router",
  "version": "0.1.0",
  "description": "URL-native modals, drawers and overlays for Next.js App Router — without the routing headache.",
  "type": "module",
  "license": "MIT",
  "author": "Ali Ranjbar",
  "repository": { "type": "git", "url": "git+https://github.com/RanjbarAli/next-modal-router.git" },
  "homepage": "https://github.com/RanjbarAli/next-modal-router#readme",
  "bugs": { "url": "https://github.com/RanjbarAli/next-modal-router/issues" },
  "keywords": ["nextjs", "next", "react", "modal", "router", "app-router", "parallel-routes", "intercepting-routes", "drawer", "sheet", "overlay", "routing"],
  "sideEffects": false,
  "files": ["dist", "assets", "docs", "README.md", "LICENSE", "CHANGELOG.md", "package.json"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.js" },
    "./cli": { "types": "./dist/cli.d.ts", "import": "./dist/cli.js" },
    "./package.json": "./package.json"
  },
  "bin": { "next-modal-router": "./dist/cli.js" },
  "engines": { "node": ">=18.17" },
  "packageManager": "pnpm@10.15.0",
  "peerDependencies": { "next": ">=14.2 <17", "react": ">=18.2 <20", "react-dom": ">=18.2 <20" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm build && pnpm --dir examples/basic typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "example:build": "pnpm --dir examples/basic build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm example:build",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": { "jiti": "^2.5.1" },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
